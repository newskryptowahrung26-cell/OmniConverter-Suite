{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/pt/blog/2000-usd-to-gbp.html",
      "destination": "/pt/blog/2000-usd-para-gbp",
      "statusCode": 301
    },
    {
      "source": "/pt/blog/2000-usd-to-gbp",
      "destination": "/pt/blog/2000-usd-para-gbp",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/feed.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
